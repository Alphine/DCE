# Disaster Commander Edge - environment template (names and placeholders only).
# Copy to .env and fill in. NEVER commit .env. Contract: docs/api.md section 9.
# Values shown are placeholders. Secrets must come from the VM's .env (mode 600) or a secret store.

# --- Runtime ------------------------------------------------------------
# development | production. production disables the local sandbox runner.
DCE_ENV=development
# Data directory for uploads, artifacts and the SQLite file.
DCE_DATA_DIR=./data
# SQLite database file (WAL mode).
DCE_DATABASE_PATH=./data/dce.sqlite3

# --- Frontend ----------------------------------------------------------
# true locally (FastAPI serves frontend/ at /). MUST be false in production (Caddy serves it).
DCE_SERVE_FRONTEND=true
DCE_FRONTEND_DIR=../frontend

# --- Inference (Vultr Serverless Inference) ----------------------------
# mock | vultr. Default mock for local development and tests.
DCE_INFERENCE_MODE=mock
DCE_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
# Must be taken from the Vultr model list when DCE_INFERENCE_MODE=vultr.
DCE_INFERENCE_MODEL=REPLACE_WITH_VULTR_MODEL_ID
# Secret. Never logged, never sent to the sandbox. Leave empty in development.
DCE_VULTR_INFERENCE_KEY=REPLACE_WITH_VULTR_INFERENCE_KEY

# --- Sandbox -----------------------------------------------------------
# local (development only, NOT isolated) | docker (production).
DCE_SANDBOX_RUNNER=local
# Pin by digest in production, for example dce-worker@sha256:<digest>.
DCE_SANDBOX_IMAGE=dce-worker:local
# Max concurrent sandbox jobs. 1 for a 2 vCPU VM, 2 only for 4 vCPU.
DCE_SANDBOX_MAX_CONCURRENT=1
# Hard execution timeout in seconds.
DCE_SANDBOX_TIMEOUT_S=30
# Memory cap per task in MB.
DCE_SANDBOX_MEMORY_MB=512
# PID cap per task.
DCE_SANDBOX_PIDS=64

# --- Cookies, CORS, quotas ---------------------------------------------
# true in production (Secure flag on the dce_session cookie).
DCE_COOKIE_SECURE=false
# Daily agent task creation quota per user.
DCE_QUOTA_TASKS_PER_DAY=20
# Development only. Production uses same-origin and does not need CORS.
DCE_CORS_ORIGINS=http://localhost:8000
# Comma-separated IPs or CIDRs whose X-Forwarded-For is trusted for rate limiting. Empty trusts no proxy.
# Production: the address Caddy connects from, as the backend sees it, for example 172.18.0.1 (Docker bridge gateway).
DCE_TRUSTED_PROXIES=

# --- Seeding (never commit) --------------------------------------------
# Password for the seed accounts (admin, analyst, reviewer, approver).
# Used only by `python -m app.seed`. Set it in the shell for one run, or in the VM's .env, never in the repo.
DCE_SEED_PASSWORD=REPLACE_WITH_STRONG_SEED_PASSWORD
