{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Disaster Commander Edge",
  "version": "0.1.0",
  "identifier": "dev.basyid.dce",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "Basyid",
    "category": "Utility",
    "shortDescription": "Disaster Commander Edge desktop",
    "longDescription": "Native Windows window for Disaster Commander Edge. Opens https://commander.basyid.dev. Requires network access on first launch.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
