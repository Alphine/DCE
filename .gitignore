backend/.venv/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node (frontend tooling, if any)
node_modules/

# Keys and certificates
*.key
*.pem

# Logs
logs/
*.log

# OS and editor
.DS_Store
Thumbs.db
.vscode/
.idea/

